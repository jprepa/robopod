# ── Django ──
# Obrigatória em produção. Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True só no PC de desenvolvimento
DEBUG=False
# Endereços aceitos: "app" é como a Evolution chama o webhook dentro do Docker.
# Acrescente o endereço do Tailscale (ex.: robopod.seu-tailnet.ts.net)
ALLOWED_HOSTS=localhost,127.0.0.1,app
# Endereço do painel com https, separados por vírgula (ex.: https://robopod.seu-tailnet.ts.net)
CSRF_TRUSTED_ORIGINS=
# true quando o painel é aberto por https (Tailscale Serve ou Nginx com SSL)
PAINEL_HTTPS=false
# Token secreto do webhook (vai na URL do webhook na Evolution: ...?token=ESTE_VALOR)
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=

# ── PostgreSQL ──
POSTGRES_DB=robopod
POSTGRES_USER=robopod
# Obrigatória (o docker-compose não sobe sem ela)
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── OpenAI ──
OPENAI_API_KEY=sk-proj-COLE_SUA_CHAVE_AQUI
OPENAI_MODEL=gpt-4o-mini
# Modelo que transcreve os áudios dos clientes
OPENAI_TRANSCRICAO_MODEL=gpt-4o-mini-transcribe

# ── Evolution API ──
EVOLUTION_API_URL=http://evolution:8080
# Obrigatória: chave longa e aleatória (mesmo gerador da DJANGO_SECRET_KEY)
EVOLUTION_API_KEY=
# Instância do primeiro número: vira a "Loja 1" na migração. Os outros números
# são cadastrados no painel (Configurações > Lojas)
EVOLUTION_INSTANCE=robopod
# Versão fixa da imagem da Evolution (veja a atual com: docker compose images evolution)
EVOLUTION_VERSION=

# ── Frete ──
ENDERECO_LOJA=Rua da Sua Loja, 123 - Bairro, Cidade - UF
# lalamove = API da Lalamove (se falhar, usa a estimativa)
# estimativa = distância x tabela abaixo | uber_scraper = scraper antigo (exige login)
FRETE_MODO=estimativa
# Opcional: coordenadas exatas da loja "lat,lng" (vazio = geocodifica ENDERECO_LOJA)
LOJA_COORDENADAS=
# Opcional (recomendado): chave com "Routes API" e "Geocoding API". Vazio = OpenStreetMap grátis
GOOGLE_MAPS_API_KEY=
# Lalamove: chaves em partnerportal.lalamove.com > Developers
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
# true = chaves pk_test/sk_test | false = pk_prod/sk_prod
LALAMOVE_SANDBOX=true
# Confira o valor da cidade com: python manage.py testar_frete --servicos
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
# estimativa: frete = max(MINIMO, BASE + km * VALOR_KM)
# todos os modos: + MARGEM%, arredondado p/ cima em R$ 0,50
FRETE_TAXA_BASE=6.00
FRETE_VALOR_KM=1.50
FRETE_VALOR_MINIMO=9.00
FRETE_MARGEM_PERCENTUAL=0
# Acima disso o pedido vai para atendente (fora da área / endereço errado)
FRETE_DISTANCIA_MAXIMA_KM=20
# Cidade usada quando o cliente não informa a cidade (vazio = fim do ENDERECO_LOJA)
FRETE_CIDADE_PADRAO=
PLAYWRIGHT_HEADLESS=true

# ── Cardápio ──
# true = lista interativa (pode não aparecer no WhatsApp via Baileys!)
WHATSAPP_MENU_INTERATIVO=false
# Opcional: URL pública de uma imagem do cardápio
CARDAPIO_IMAGEM_URL=

# ── Avisos à equipe ──
# O grupo do WhatsApp que recebe os avisos é escolhido no painel (Configurações).
# Opcional: endereço público do painel, para os avisos virem com link da conversa
PAINEL_URL=

# ── PIX ──
CHAVE_PIX=sua-chave-pix-aqui

# ── Painel ──
# Hora da virada do dia nos relatórios (6 = vendas até 05:59 contam na noite anterior)
PAINEL_VIRADA_DIA_HORA=6

# ── Segurança ──
# Login do painel: bloqueia por N minutos depois de N senhas erradas seguidas
LOGIN_TENTATIVAS_MAXIMAS=5
LOGIN_BLOQUEIO_MINUTOS=15
# Dias até apagar o endereço dos pedidos entregues/cancelados
RETENCAO_ENDERECO_DIAS=3
# Dias até apagar o histórico das conversas (painel, IA e Evolution)
RETENCAO_MENSAGENS_DIAS=3
