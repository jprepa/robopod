# ── Django ──
DJANGO_SECRET_KEY=troque-por-uma-chave-segura-longa-aleatoria
DEBUG=False
ALLOWED_HOSTS=*

# ── PostgreSQL ──
POSTGRES_DB=robopod
POSTGRES_USER=robopod
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── OpenAI ──
OPENAI_API_KEY=sk-proj-COLE_SUA_CHAVE_AQUI
OPENAI_MODEL=gpt-4o-mini

# ── Evolution API ──
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=minha-chave-evolution
EVOLUTION_INSTANCE=robopod

# ── Frete ──
ENDERECO_LOJA=Rua da Sua Loja, 123 - Bairro, Cidade - UF
# estimativa = distância x tabela abaixo | uber_scraper = scraper antigo (exige login)
FRETE_MODO=estimativa
# Opcional (recomendado): chave com "Routes API" ativada. Vazio = OpenStreetMap grátis
GOOGLE_MAPS_API_KEY=
# frete = max(MINIMO, BASE + km * VALOR_KM) + MARGEM%, arredondado p/ cima em R$ 0,50
FRETE_TAXA_BASE=6.00
FRETE_VALOR_KM=1.50
FRETE_VALOR_MINIMO=9.00
FRETE_MARGEM_PERCENTUAL=0
# Acima disso o pedido vai para atendente (fora da área / endereço errado)
FRETE_DISTANCIA_MAXIMA_KM=20
PLAYWRIGHT_HEADLESS=true

# ── Cardápio ──
# true = lista interativa (pode não aparecer no WhatsApp via Baileys!)
WHATSAPP_MENU_INTERATIVO=false
# Opcional: URL pública de uma imagem do cardápio
CARDAPIO_IMAGEM_URL=

# ── Microsoft Teams (opcional) ──
TEAMS_WEBHOOK_URL=

# ── PIX ──
CHAVE_PIX=sua-chave-pix-aqui
